{
  "name": "llm-benchmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eeshansrivastava89/llm-benchmarks.git"
  },
  "homepage": "https://localai.eeshans.com/",
  "bugs": {
    "url": "https://github.com/eeshansrivastava89/llm-benchmarks/issues"
  },
  "bin": {
    "bench": "./bin/bench.mjs"
  },
  "scripts": {
    "bench": "node ./bin/bench.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:static": "node scripts/build-static.mjs",
    "audit:static": "node scripts/audit-static-build.mjs",
    "publish": "node scripts/publish.mjs",
    "check:bench": "node scripts/check-syntax.mjs && uv run python -m compileall -q ./src/bench_inspect ./benchmarks ./scripts",
    "check:visual": "astro check && tsc --noEmit",
    "check": "npm run check:bench && npm run check:visual",
    "test:bench": "node --test ./test/*.test.mjs",
    "test:visual": "vitest run",
    "test": "npm run test:bench && npm run test:visual",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.1.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@tailwindcss/vite": "4.3.0",
    "astro": "^6.3.3",
    "smol-toml": "1.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "yaml": "^2.8.4",
    "js-yaml": "^4.2.0",
    "esbuild": "^0.28.1",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
